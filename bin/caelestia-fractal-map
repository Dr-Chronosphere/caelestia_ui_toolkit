#!/usr/bin/env sh
# Toggle the Fractal Map overlay (the fractal-wm window tree, drawn in Caelestia style).
#
#   caelestia-fractal-map [toggle|open|close] [workspace-id]
#
# The overlay runs as its own Quickshell instance. The first call starts it in the
# background; later calls just send it a message, so toggling is instant.
set -e
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
repo=$(dirname "$here")
dir="$repo/apps/fractal-map"
export QML_IMPORT_PATH="$repo/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"

cmd=${1:-toggle}
ws=${2:-}

call() { qs -p "$dir" ipc call fractalmap "$@"; }

if ! call isOpen >/dev/null 2>&1; then
    qs -p "$dir" --no-duplicate --daemonize >/dev/null 2>&1 || true
    i=0
    until call isOpen >/dev/null 2>&1; do
        i=$((i + 1))
        [ "$i" -gt 30 ] && { echo "caelestia-fractal-map: overlay did not start" >&2; exit 1; }
        sleep 0.1
    done
fi

case "$cmd" in
    open) call open "$ws" ;;
    toggle | close) call "$cmd" ;;
    *) echo "usage: caelestia-fractal-map [toggle|open [workspace]|close]" >&2; exit 2 ;;
esac
