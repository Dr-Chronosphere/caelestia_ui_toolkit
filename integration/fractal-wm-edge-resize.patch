+  eq(box(nodes[col.id]), "684,0,684,886")
+  eq(box(nodes[col.children[1].id]), box(boxes.b))
+end)
+
+test("edge moves the boundary between two adjacent siblings", function()
+  local t = T.new()
+  make(t, "a")
+  T.add_window(t, "b", "B", WIDE)
+  local a, b = t.root.children[1], t.root.children[2]
+  eq(T.edge(t, a.id, b.id, 0.25), true)
+  eq(box(T.layout(t, WIDE).a), "0,0,342,886")
+  eq(box(T.layout(t, WIDE).b), "342,0,1026,886")
+  -- naming the pair the other way round: the first argument still gets `ratio` of the space
+  eq(T.edge(t, b.id, a.id, 0.25), true)
+  eq(box(T.layout(t, WIDE).b), "1026,0,342,886")
+  eq(a.weight + b.weight, 2, "combined weight preserved")
+end)
+
+test("edge clamps to the weight limits and rejects non-adjacent or non-sibling nodes", function()
+  local t = T.new()
+  make(t, "a")
+  T.add_window(t, "b", "B", WIDE)
+  T.add_window(t, "c", "C", WIDE)           -- a | (b / c)
+  local a, col = t.root.children[1], t.root.children[2]
+  local b, c = col.children[1], col.children[2]
+  eq(T.edge(t, a.id, col.id, 0.001), true)
+  eq(a.weight >= 0.2 - 1e-9 and a.weight <= 5, true, "clamped")
+  eq(T.edge(t, a.id, b.id, 0.5), false, "not siblings")
+  eq(T.edge(t, b.id, b.id, 0.5), false, "same node")
+  eq(T.edge(t, b.id, "nope", 0.5), false, "unknown id")
+  eq(T.edge(t, b.id, c.id, "x"), false, "bad ratio")
+  eq(T.edge(t, b.id, c.id, 0.7), true)
+  local lb = T.layout(t, WIDE)
+  eq(math.abs(lb.b.h - 0.7 * 886) < 0.01, true, "b gets 70% of the column")
+  eq(math.abs(lb.c.h - 0.3 * 886) < 0.01, true, "c gets the rest")
+end)
+
+test("edge ignores hidden siblings and refuses tabs containers", function()
+  local t = T.new()
+  T.attach(t.root, leaf(t, "a"))
+  T.attach(t.root, leaf(t, "b"))
+  T.attach(t.root, leaf(t, "c"))
+  local a, b, c = t.root.children[1], t.root.children[2], t.root.children[3]
+  T.hide(t, b.id)
+  eq(T.edge(t, a.id, c.id, 0.5), true, "a and c are adjacent once b is hidden")
+  eq(T.edge(t, a.id, b.id, 0.5), false, "hidden tile has no edge")
+  local tabs_t = T.new()
+  local tabs = T.attach(tabs_t.root, T.node(tabs_t, "tabs"))
+  T.attach(tabs, leaf(tabs_t, "x")); T.attach(tabs, leaf(tabs_t, "y"))
+  eq(T.edge(tabs_t, tabs.children[1].id, tabs.children[2].id, 0.5), false, "tabs have no edges")
+end)
+
+test("status JSON carries node boxes and the work area when geometry is set", function()
+  local t = T.new()
+  make(t, "a")
+  T.add_window(t, "b", "B", WIDE)
+  eq(T.to_json(t):find('"box"', 1, true), nil, "no geometry, no boxes")
+  local nodes = {}
+  T.layout(t, WIDE, nodes)
+  t.geometry = { area = WIDE, nodes = nodes }
+  local j = T.to_json(t)
+  eq(j:find('"area":{"x":0.0,"y":0.0,"w":1368.0,"h":886.0}', 1, true) ~= nil, true, "area")
+  eq(j:find('"box":{"x":684.0,"y":0.0,"w":684.0,"h":886.0}', 1, true) ~= nil, true, "window box")
+end)
