+test("a floated window keeps its slot (no reflow) for the grace period, then is released", function()
+  local t = T.new()
+  make(t, "a", "b", "c")
+  local floated = { b = true }
+  local opts = { exists = function(a) return floated[a] == true end, now = 100, grace = 1 }
+  local before = keys(T.layout(t, WIDE))
+  T.sync(t, live("a", "c"), WIDE, opts)
+  eq(keys(T.layout(t, WIDE)), before, "b's slot is still in the tree: the others did not reflow")
+  eq(T.find_window(t, "b") ~= nil, true)
+  opts.now = 100.5
+  T.sync(t, live("a", "c"), WIDE, opts)
+  eq(T.find_window(t, "b") ~= nil, true, "still within the grace period")
+  opts.now = 102
+  T.sync(t, live("a", "c"), WIDE, opts)
+  eq(T.find_window(t, "b"), nil, "released once the grace is over (a window floated on purpose)")
+end)
