+-- ------------------------------------------------------------ place / drop intent --
+
+test("place moves a window beside another: a | (b / c), c left of a", function()
+  local t = T.new()
+  make(t, "a")
+  T.add_window(t, "b", "B", WIDE)
+  T.set_focus(t, "b")
+  T.add_window(t, "c", "C", WIDE)            -- a | (b / c)
+  eq(T.place(t, "c", "a", "left"), true)
+  eq(addrs(t.root), "c,a,b", "c joins the root row; the column around b collapsed")
+  eq(t.focused, "c")
+end)
+
+test("place beside a window whose parent runs the same way joins that row, and the root is flattened", function()
+  local t = T.new()
+  make(t, "a", "b", "c")                      -- a | (b | c) built without an area
+  eq(T.place(t, "a", "c", "right"), true)
+  eq(addrs(t.root), "b,c,a", "no redundant single-child level is left at the root")
+  eq(T.place(t, "a", "b", "left"), true)
+  eq(addrs(t.root), "a,b,c")
+end)
+
+test("place up/down wraps the target in a column", function()
+  local t = T.new()
+  make(t, "a", "b")
+  eq(T.place(t, "b", "a", "up"), true)
+  eq(t.root.kind, "column")
+  eq(addrs(t.root), "b,a")
+  eq(T.place(t, "b", "a", "down"), true)
+  eq(addrs(t.root), "a,b")
+end)
+
+test("center swaps two windows, even across containers", function()
+  local t = T.new()
+  make(t, "a")
+  T.add_window(t, "b", "B", WIDE)
+  T.set_focus(t, "b")
+  T.add_window(t, "c", "C", WIDE)            -- a | (b / c)
+  eq(T.place(t, "a", "c", "center"), true)
+  eq(addrs(t.root), "c,column", "c where a was, a where c was")
+  eq(addrs(t.root.children[2]), "b,a")
+  eq(T.find_window(t, "a").parent, t.root.children[2], "parent links follow")
+end)
+
+test("place rejects unknown windows, itself and bad zones", function()
+  local t = T.new()
+  make(t, "a", "b")
+  eq(T.place(t, "a", "a", "left"), false)
+  eq(T.place(t, "a", "zz", "left"), false)
+  eq(T.place(t, "a", "b", "sideways"), false)
+  eq(addrs(t.root), "a,b", "tree untouched")
+end)
+
+test("drop intent: the re-added window lands where the drop was aimed, not at the focus", function()
+  local t = T.new()
+  make(t, "a", "b", "c")
+  T.remove_window(t, "a")                    -- dragged out (floating)
+  T.set_intent(t, { src = "a", dst = "b", zone = "left" })
+  T.add_window(t, "a", "A", WIDE)            -- re-tiled after the drop
+  eq(addrs(t.root), "a,b,c")
+  eq(t.intent, nil, "used up")
+  eq(t.focused, "a")
+end)
+
+test("an intent for another window, an expired one, or a vanished target is ignored", function()
+  local t = T.new()
+  make(t, "a", "b")
+  T.set_intent(t, { src = "x", dst = "a", zone = "left" })
+  T.add_window(t, "y", "Y", WIDE)
+  assert(t.intent ~= nil, "kept for its own window")
+  t.intent = { src = "z", dst = "a", zone = "left", at = os.time() - 100 }
+  T.add_window(t, "z", "Z", WIDE)
+  eq(t.intent, nil, "expired intents are dropped")
+  eq(T.find_window(t, "z") ~= nil, true, "the window is still added normally")
+  t.intent = { src = "w", dst = "gone", zone = "left", at = os.time() }
+  T.add_window(t, "w", "W", WIDE)
+  eq(T.find_window(t, "w") ~= nil, true, "target gone: falls back to the normal split")
+end)
+
+test("swap intent on a re-tiled window: it takes the target's slot and the target takes its old one", function()
+  local t = T.new()
+  make(t, "a", "b")                          -- a | b
+  T.remove_window(t, "a")                    -- a is dragged out
+  T.set_intent(t, { src = "a", dst = "b", zone = "center" })
+  T.add_window(t, "a", "A", WIDE)
+  eq(addrs(t.root), "b,a", "a and b swapped")
+  eq(t.focused, "a")
+end)
+
+test("swap intent across the tree: a | (b | c), a dropped on c gives c | (b | a)", function()
+  local t = T.new()
+  make(t, "a", "b", "c")
+  T.remove_window(t, "a")
+  T.set_intent(t, { src = "a", dst = "c", zone = "center" })
+  T.add_window(t, "a", "A", WIDE)
+  local order = {}
+  for _, l in ipairs(T.windows(t.root)) do order[#order + 1] = l.address end
+  eq(table.concat(order, ","), "c,b,a")
+end)
+
+test("swap intent with no remembered slot still places the window beside the target", function()
+  local t = T.new()
+  make(t, "a", "b")
+  T.set_intent(t, { src = "z", dst = "b", zone = "center" })
+  T.add_window(t, "z", "Z", WIDE)
+  eq(T.find_window(t, "z") ~= nil and T.find_window(t, "b") ~= nil, true)
+  eq(#T.windows(t.root), 3)
+end)
