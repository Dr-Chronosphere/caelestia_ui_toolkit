+-- Move the edge between two adjacent siblings of a row/column so that `a` gets
+-- `ratio` (0-1) of the space the two share. Only the shown siblings count (hidden
+-- and out-of-view ones take no space), the pair's combined weight is preserved, and
+-- both weights stay within the usual limits. Returns true if the weights changed.
+function T.edge(tree, a_id, b_id, ratio)
+  local a, b = T.find(tree, a_id), T.find(tree, b_id)
+  ratio = tonumber(ratio)
+  if not a or not b or not ratio or a == b or a.parent ~= b.parent then return false end
+  local parent = a.parent
+  if not parent or (parent.kind ~= "row" and parent.kind ~= "column") then return false end
+  local shown = {}
+  for _, c in ipairs(parent.children) do
+    if has_visible(tree, c) then shown[#shown + 1] = c end
+  end
+  local ia, ib
+  for i, c in ipairs(shown) do
+    if c == a then ia = i elseif c == b then ib = i end
+  end
+  if not ia or not ib or math.abs(ia - ib) ~= 1 then return false end
+  if ia > ib then ratio = 1 - ratio end -- `a` is the later sibling: ratio is its share
+  if ia > ib then a, b = b, a end         -- normalise: a is first, b second
+  local sum = a.weight + b.weight
+  local lo, hi = math.max(MIN_WEIGHT, sum - MAX_WEIGHT), math.min(MAX_WEIGHT, sum - MIN_WEIGHT)
+  if lo > hi then return false end
+  local wa = math.min(hi, math.max(lo, ratio * sum))
+  if math.abs(wa - a.weight) < 1e-9 then return true end
+  a.weight, b.weight = wa, sum - wa
+  return true
+end
+
