+-- Where a parked window goes under the "camera" parking: the screen position it would have if the
+-- view were a camera zoomed onto the viewport (the world scaled so the viewport fills the work
+-- area), then slid to just beyond the nearest screen edge, keeping `inset` px inside the monitor
+-- (a window must overlap its monitor to be rendered). So when you zoom, windows leave the screen
+-- outward in their own direction, as a real zoom would, instead of all flying to one corner.
+-- Returns nil when the window would still be on screen (a window in an inactive tab sits under the
+-- visible one) or is unknown: the caller falls back to the corner.
+local function camera_park(area, wb, vb, bw, bh, inset)
+  if not (wb and vb) or vb.w <= 0 or vb.h <= 0 then return nil end
+  local sx, sy = area.w / vb.w, area.h / vb.h
+  local box = { x = area.x + (wb.x - vb.x) * sx, y = area.y + (wb.y - vb.y) * sy, w = bw, h = bh }
+  if intersects(box, { x = area.x + 2, y = area.y + 2, w = area.w - 4, h = area.h - 4 }) then return nil end
+  if box.x + box.w <= area.x then box.x = area.x - box.w + inset
+  elseif box.x >= area.x + area.w then box.x = area.x + area.w - inset end
+  if box.y + box.h <= area.y then box.y = area.y - box.h + inset
+  elseif box.y >= area.y + area.h then box.y = area.y + area.h - inset end
+  return box
+end
